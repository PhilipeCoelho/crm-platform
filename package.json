{
  "name": "crm-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node api/index.js",
    "server": "node api/index.js",
    "dev": "concurrently \"vite\" \"nodemon api/index.js\"",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "clean-cache": "rm -rf node_modules .vite",
    "sdr:activate-live": "node scripts/toggle_legal_gate.mjs live",
    "sdr:lock-staging": "node scripts/toggle_legal_gate.mjs lock",
    "sdr:daemon": "node scripts/sdr_worker_daemon.mjs",
    "sdr:status": "node -e \"import('./api/sdr_worker.js').then(({ defaultSDRWorker }) => console.log(JSON.stringify(defaultSDRWorker.getStatus(), null, 2)))\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.94.1",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-window": "^1.8.8",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "body-parser": "^2.2.2",
    "clsx": "^2.1.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "date-fns": "^3.3.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "framer-motion": "^12.34.3",
    "imap": "^0.8.19",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.344.0",
    "mailparser": "^3.9.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-grid-layout": "^2.2.2",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.30.3",
    "react-window": "^2.2.7",
    "recharts": "^3.7.0",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@types/react-grid-layout": "^1.3.6",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "nodemon": "^3.1.11",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.4"
  }
}
